// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db" // This points to a local SQLite database file
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String?  @unique
  name      String?
  password  String
  role      String   @default("USER") // Roles can be "USER" or "ADMIN"
  createdAt DateTime @default(now())
}
